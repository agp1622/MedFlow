{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/MedFlow.Api/MedFlow.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/MedFlow.Api/MedFlow.Api.csproj",
        "--no-launch-profile",
        "--urls",
        "http://localhost:5080"
      ],
      "problemMatcher": []
    }
  ]
}
